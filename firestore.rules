rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /siteData/{documentId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid in [
          'aWxUFqpKBuXlap7OL0bSFq17zmr1',
          'LDpvmSAOS4eUzlwYMpuv9ANgO6R2'
        ];
    }
  }
}
